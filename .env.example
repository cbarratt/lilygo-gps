# Copy this file to `.env` (which is gitignored) for local USB builds.
# These become compile-time DEFAULTS only; on the device they can also be set
# via the /config page (stored in NVS) and survive OTA updates.
#
# Leave blank/omit to build a credential-free image (device starts in AP mode
# `TTGO-GPS-Setup` for first-time config). CI/OTA builds have no .env, so they
# ship blank and rely on the device's saved NVS config.

WIFI_SSID=YourWiFiName
WIFI_PASS=YourWiFiPassword
# OTA_TOKEN=github_pat_...   # only if using OTA from a private repo
